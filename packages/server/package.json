{
  "name": "@kartiseret/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    "./app": "./dist/app.js",
    "./catalog-timing": "./dist/catalog-timing.js",
    "./production": "./dist/production.js",
    "./catalog": "./dist/catalog/index.js",
    "./public-data": "./dist/public-data/index.js",
    "./vercel-dispatch": "./dist/vercel-dispatch.js",
    "./social-preview": "./dist/social-preview.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck:integration",
    "lint": "eslint src tests scripts vitest.config.ts vitest.integration.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node scripts/with-test-database.mjs -- npm run test:integration:run --workspace=@kartiseret/server",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "db:test:bootstrap": "node scripts/bootstrap-test-database.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "@kartiseret/contracts": "^1.0.0",
    "@vercel/functions": "3.11.3",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.4",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  }
}
