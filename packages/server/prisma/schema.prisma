generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// This schema is a mapped query/client contract. SQL in supabase/migrations is the
// sole authority for DDL, RLS, provider FKs, partial indexes, and CHECK constraints.
// PostgreSQL nullable scalar lists cannot be represented by Prisma. finalMovies.genres
// is mapped as String[]; API mapping safely treats a database NULL as an empty list.

model AdminUser {
  userId    String   @id(map: "admin_users_pkey") @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_users")
}

model AllShowtime {
  id               String    @id(map: "allShowtimes_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  englishTitle     String?   @map("english_title") @db.Text
  releaseYear      Int?      @map("release_year") @db.SmallInt
  originalLanguage String?   @map("original_language") @db.Text
  screeningCity    String?   @map("screening_city") @db.Text
  dateOfShowing    DateTime? @map("date_of_showing") @db.Date
  showtime         DateTime? @db.Time(6)
  cinema           String?   @db.Text
  englishHref      String?   @map("english_href") @db.Text
  screeningType    String?   @map("screening_type") @db.Text
  hebrewTitle      String?   @map("hebrew_title") @db.Text
  hebrewHref       String?   @map("hebrew_href") @db.Text
  dubLanguage      String?   @map("dub_language") @db.Text
  rating           String?   @db.Text
  directedBy       String?   @map("directed_by") @db.Text
  runtime          Int?      @db.SmallInt
  screeningTech    String?   @map("screening_tech") @db.Text
  tmdbId           Int?      @map("tmdb_id") @db.Integer
  runId            Int?      @map("run_id") @db.Integer
  cleaned          Boolean?  @default(false) @db.Boolean
  added            Boolean?  @db.Boolean

  @@map("allShowtimes")
}

model AllSoon {
  id               String    @id(map: "allsoons_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime  @default(dbgenerated("(now() AT TIME ZONE 'Asia/Jerusalem'::text)")) @map("created_at") @db.Timestamptz(6)
  hebrewTitle      String?   @map("hebrew_title") @db.Text
  englishTitle     String?   @map("english_title") @db.Text
  releaseDate      DateTime? @map("release_date") @db.Date
  originalLanguage String?   @map("original_language") @db.Text
  releaseYear      Int?      @map("release_year") @db.SmallInt
  rating           String?   @db.Text
  directedBy       String?   @map("directed_by") @db.Text
  runtime          Int?      @db.SmallInt
  cinema           String?   @db.Text
  runId            Int?      @map("run_id") @db.Integer
  cleaned          Boolean   @default(false) @db.Boolean
  added            Boolean   @default(false) @db.Boolean

  @@map("allSoons")
}

model AllTheque {
  id               String    @id(map: "allTheques_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  englishTitle     String?   @map("english_title") @db.Text
  hebrewTitle      String?   @map("hebrew_title") @db.Text
  englishHref      String?   @map("english_href") @db.Text
  hebrewHref       String?   @map("hebrew_href") @db.Text
  screeningType    String?   @map("screening_type") @db.Text
  screeningTech    String?   @map("screening_tech") @db.Text
  originalLanguage String?   @map("original_language") @db.Text
  dubLanguage      String?   @map("dub_language") @db.Text
  dateOfShowing    DateTime? @map("date_of_showing") @db.Date
  showtime         DateTime? @db.Time(6)
  releaseYear      Int?      @map("release_year") @db.SmallInt
  releaseDate      DateTime? @map("release_date") @db.Date
  directedBy       String?   @map("directed_by") @db.Text
  runtime          Int?      @db.SmallInt
  rating           String?   @db.Text
  screeningCity    String?   @map("screening_city") @db.Text
  cinema           String?   @db.Text
  tmdbId           Int?      @map("tmdb_id") @db.Integer
  runId            Int?      @map("run_id") @db.Integer
  cleaned          Boolean   @default(false) @db.Boolean
  added            Boolean   @default(false) @db.Boolean

  @@map("allTheques")
}

model City {
  name              String   @id(map: "cities_pkey") @db.Text
  altSpellings      String[] @default([]) @map("alt_spellings") @db.Text
  zoomLayer         Float?   @map("zoom_layer") @db.Real
  latitude          Float?   @db.DoublePrecision
  longitude         Float?   @db.DoublePrecision
  neighboringCities String[] @default([]) @map("neighboring_cities") @db.Text

  @@map("cities")
}

model FinalMovie {
  popularity       Float?    @db.DoublePrecision
  englishTitle     String    @map("english_title") @db.Text
  releaseYear      BigInt?   @map("release_year") @db.BigInt
  runtime          Float?    @db.Real
  tmdbId           Int       @id(map: "finalmovies_pkey") @map("tmdb_id") @db.Integer
  imdbRating       Float?    @db.DoublePrecision
  imdbVotes        String?   @default("") @db.Text
  rtAudienceRating String?   @default("") @db.Text
  enPoster         String?   @map("en_poster") @db.Text
  backdrop         String?   @db.Text
  imdbId           String?   @map("imdb_id") @db.Text
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  runId            Int?      @map("run_id") @db.Integer
  rtAudienceVotes  Int?      @db.Integer
  rtId             String?   @map("rt_id") @db.Text
  lbId             String?   @map("lb_id") @db.Text
  lbRating         Float?    @db.Real
  lbVotes          Int?      @db.Integer
  tmdbRating       Int?      @db.Integer
  tmdbVotes        Int?      @db.Integer
  rtCriticRating   Int?      @db.Integer
  rtCriticVotes    Int?      @db.Integer
  enTrailer        String?   @map("en_trailer") @db.Text
  genres           String[]  @db.Text
  altOptions       Json      @default("[]") @map("alt_options") @db.JsonB
  soloUpdate       Boolean   @default(false) @map("solo_update") @db.Boolean

  @@map("finalMovies")
}

model FinalShowtime {
  id               String    @id(map: "finalshowtimes_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime? @default(dbgenerated("(now() AT TIME ZONE 'Asia/Jerusalem'::text)")) @map("created_at") @db.Timestamptz(6)
  englishTitle     String?   @map("english_title") @db.Text
  originalLanguage String?   @map("original_language") @db.Text
  screeningCity    String?   @map("screening_city") @db.Text
  dateOfShowing    DateTime? @map("date_of_showing") @db.Date
