  avgTimeM5Mac    Float?  @default(0) @map("avg_time_m5_mac") @db.DoublePrecision

  @@map("utilAvgTime")
}

model UtilRunLog {
  runId           Int      @id(map: "utilrunlogs_pkey") @map("run_id") @db.Integer
  selectedRunners Json     @default("[]") @map("selected_runners") @db.JsonB
  successful      Boolean? @db.Boolean
  totalTime       Float?   @map("total_time") @db.DoublePrecision
  dateCreated     DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Jerusalem'::text)")) @map("date_created") @db.Timestamp(6)
  runningNow      Boolean  @default(false) @map("running_now") @db.Boolean
  runFrom         String?  @map("run_from") @db.Text

  @@map("utilRunLogs")
}
