model MovieCode {
  tmdbId    BigInt   @id(map: "movieCodes_pkey") @map("tmdb_id") @db.BigInt
  movieCode String   @unique(map: "movieCodes_movie_code_key") @map("movie_code") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("movieCodes")
}

model TableFix {
  tmdbId   String @map("tmdb_id") @db.Text
  titleFix String @map("title_fix") @db.Text
  id       String @id(map: "tableFixes_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("tableFixes")
}

model TableSkip {
