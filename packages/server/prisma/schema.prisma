  @@map("theaters")
}

model TicketAlertSubscription {
  userId                String    @map("user_id") @db.Uuid
  tmdbId                BigInt    @map("tmdb_id") @db.BigInt
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  notifiedAt            DateTime? @map("notified_at") @db.Timestamptz(6)
  deliveryId            String?   @map("delivery_id") @db.Uuid
  deliveryTitle         String?   @map("delivery_title") @db.Text
  deliveryCity          String?   @map("delivery_city") @db.Text
  deliveryDate          DateTime? @map("delivery_date") @db.Date
  deliveryHref          String?   @map("delivery_href") @db.Text
  deliveryMovieCode     String?   @map("delivery_movie_code") @db.Text
  deliveryAttempts      Int       @default(0) @map("delivery_attempts") @db.Integer
  lastDeliveryAttemptAt DateTime? @map("last_delivery_attempt_at") @db.Timestamptz(6)
  lastDeliveryError     String?   @map("last_delivery_error") @db.Text
  resendEmailId         String?   @map("resend_email_id") @db.Text

  @@id([userId, tmdbId], map: "ticket_alert_subscriptions_pkey")
  @@map("ticket_alert_subscriptions")
}

model UserPreference {
  userId        String   @id(map: "userpreferences_pkey") @map("user_id") @db.Uuid
