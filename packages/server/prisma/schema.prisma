model FinalSoon {
  imdbId       String?   @map("imdb_id") @db.Text
  englishTitle String    @map("english_title") @db.Text
  hebrewTitle  String    @map("hebrew_title") @db.Text
  releaseDate  DateTime  @map("release_date") @db.Date
  enPoster     String?   @map("en_poster") @db.Text
  backdrop     String?   @db.Text
  tmdbId       Int       @map("tmdb_id") @db.Integer
  oldUuid      String?   @map("old_uuid") @db.Uuid
  id           String    @id(map: "finalsoons_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  runId        Int?      @map("run_id") @db.Integer
  releaseYear  Int?      @map("release_year") @db.SmallInt
  enTrailer    String?   @map("en_trailer") @db.Text
  genres       String[]  @db.Text
  runtime      Int?      @db.Integer
  altOptions   Json      @default("[]") @map("alt_options") @db.JsonB
  soloUpdate   Boolean   @default(false) @map("solo_update") @db.Boolean
  popularity   Float?    @db.DoublePrecision

  @@map("finalSoons")
}

model FinalThequeMovie {
  tmdbId           Int      @id(map: "finalThequeMovies_pkey") @map("tmdb_id") @db.Integer
  englishTitle     String   @map("english_title") @db.Text
  hebrewTitle      String?  @map("hebrew_title") @db.Text
  releaseYear      Int?     @map("release_year") @db.SmallInt
  runtime          Int?     @db.SmallInt
  popularity       Float?   @db.DoublePrecision
  imdbId           String?  @map("imdb_id") @db.Text
  imdbRating       Decimal? @db.Decimal(3, 1)
  imdbVotes        BigInt?  @db.BigInt
  rtId             String?  @map("rt_id") @db.Text
  rtAudienceRating Int?     @db.SmallInt
  rtAudienceVotes  BigInt?  @db.BigInt
  rtCriticRating   Int?     @db.SmallInt
  rtCriticVotes    BigInt?  @db.BigInt
  lbId             String?  @map("lb_id") @db.Text
  lbRating         Decimal? @db.Decimal(2, 1)
  lbVotes          BigInt?  @db.BigInt
  tmdbRating       Int?     @db.SmallInt
  tmdbVotes        BigInt?  @db.BigInt
  enPoster         String?  @map("en_poster") @db.Text
  backdrop         String?  @db.Text
  enTrailer        String?  @map("en_trailer") @db.Text
  genres           String[] @default([]) @db.Text
  altOptions       Json     @default("[]") @map("alt_options") @db.JsonB
  soloUpdate       Boolean  @default(false) @map("solo_update") @db.Boolean
  runId            Int?     @map("run_id") @db.Integer
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("finalThequeMovies")
}

