{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/og.ts": {
      "includeFiles": "dist/**"
    },
    "api/og-image.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/movies",
      "destination": "/index.html"
    },
    {
      "source": "/showtimes",
      "destination": "/index.html"
    },
    {
      "source": "/soons",
      "destination": "/index.html"
    },
    {
      "source": "/user",
      "destination": "/index.html"
    },
    {
      "source": "/attribution",
      "destination": "/index.html"
    },
    {
      "source": "/:routeCode([0-9A-Za-z]{3,10})",
      "destination": "/api/og?routeCode=:routeCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
