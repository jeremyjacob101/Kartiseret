{
  "name": "kartiseret-web",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run build --workspace=@kartiseret/contracts",
    "dev": "vite --config config/vite.config.ts",
    "prebuild": "npm run build --workspace=@kartiseret/contracts",
    "build": "npm run typecheck && npm run build:bundle",
    "typecheck": "npm run build --workspace=@kartiseret/contracts && npm run typecheck:contracts && npm run typecheck:source",
    "typecheck:contracts": "npm run typecheck --workspace=@kartiseret/contracts",
    "bundle:check": "node tests/check-client-bundle.mjs",
    "lint": "eslint .",
    "pretest": "npm run build --workspace=@kartiseret/contracts",
    "test": "npm run test:run",
    "e2e": "npm run build --workspace=@kartiseret/contracts && node ../packages/server/scripts/with-test-database.mjs -- npm run e2e:run --workspace=kartiseret-web",
    "e2e:run": "playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "prettier --ignore-path ../.gitignore --cache --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\"",
    "format:check": "prettier --ignore-path ../.gitignore --check \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\"",
    "preview": "vite preview --config config/vite.config.ts",
    "verify": "npm run lint && npm run format:check && npm test && npm run build && npm run test:ssr-browser && npm run bundle:check && npm --prefix .. run clean:web-build",
    "build:bundle": "vite build --config config/vite.config.ts && vite build --config config/vite.config.ts --ssr src/entry-server.tsx --outDir dist-ssr && node tests/seo/ssrBuiltOutput.mjs",
    "test:ssr-browser": "node tests/seo/ssrBrowserSmoke.mjs",
    "typecheck:source": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p config/tsconfig.node.json && tsc --noEmit -p config/tsconfig.server.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:run": "vitest run"
  },
  "prettier": {
    "plugins": [
      "./config/prettier-plugin-single-line-imports.mjs"
    ],
    "singleLineImports": true,
    "sortTopImportsByLength": true,
    "overrides": [
      {
        "files": [
          "**/*.{js,jsx,cjs,mjs}"
        ],
        "options": {
          "parser": "imports-babel"
        }
      },
      {
        "files": [
          "**/*.{ts,tsx,cts,mts}"
        ],
        "options": {
          "parser": "imports-typescript"
        }
      }
    ]
  },
  "dependencies": {
    "@kartiseret/contracts": "^1.0.0",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "1.7.25",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "zod": "^4.4.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
