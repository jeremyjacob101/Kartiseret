# For optional local Node development, copy the DEV project's Supavisor
# transaction-pooler URL from Connect. Shared-pooler usernames use
# kartiseret_api.<project-ref>; use the least-privilege runtime login.
# Preview uses DEV; Production uses the separate production runtime login.
# The Node pg pool enforces verified TLS for remote hosts. Supabase's database
# CA is not in Node's public trust store, so copy its full PEM from Database
# Settings > SSL Configuration into DATABASE_SSL_CA_CERT. Do not add
# ORM-specific schema query options or unverified sslmode=require options.
DATABASE_URL=postgresql://kartiseret_api.project-ref:replace-me@transaction-pooler-host:6543/postgres
DATABASE_SSL_CA_CERT=replace-with-full-Supabase-CA-certificate-PEM
DATABASE_POOL_MAX=1
# Optional category publication transport. Use the direct PostgreSQL endpoint
# or Supavisor session mode on port 5432, with the dedicated login provisioned
# by docs/postgres-publication-publisher.md. If unset, Python uses the REST RPC.
PUBLICATION_DATABASE_URL=postgresql://kartiseret_publisher_login.project-ref:replace-me@session-pooler-host:5432/postgres
PUBLICATION_DATABASE_SSL_CA_CERT=replace-with-full-Supabase-CA-certificate-PEM
NODE_ENV=development
PORT=3000
SITE_ORIGIN=http://localhost:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Server-side movie search and Python pipeline only. Never expose as VITE_*.
TMDB_API_KEY=replace-me

# SQL migrations use Supabase CLI and a separate direct/admin connection.
# Never use this elevated connection as DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres:replace-me@db.project-ref.supabase.co:5432/postgres

# Python's service-side table access and Realtime retain Supabase configuration.
# These values are no longer read by the browser or Node identity verifier.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Test bootstrap accepts only this local disposable database; it never reads
# DATABASE_URL and refuses any other host or database name.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kartiseret_test

# PR5 account API (server only). Generate independent random secrets per environment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_SECRET=replace-with-a-different-random-secret
# Local browser origin, not the proxied API port. Vercel can use its immutable
# VERCEL_URL automatically; Production should explicitly use https://seret.site.
BETTER_AUTH_URL=http://localhost:5173
RESEND_API_KEY=replace-me
# Preview only sends to explicitly allowed test recipients. Local/CI tests inject
# a captured transport; the deployed app never exposes captured tokens.
AUTH_EMAIL_ALLOWED_RECIPIENTS=your-controlled-dev-mailbox@example.com

# Python ticket-alert recipient lookup: explicit origin and matching INTERNAL_API_SECRET.
# Keep SITE_URL for email links distinct from the internal API origin.
TICKET_ALERT_RECIPIENT_API_URL=http://localhost:5173
TICKET_ALERT_INTERNAL_API_SECRET=replace-with-matching-internal-secret
