# Copy to .env. Keep development and production values side by side.
# Scraper runs ask for a target unless KARTISERET_TARGET is explicitly set.
# Scheduled local runs default to production. Never commit .env.
#
# Python scraper/dataflow requires Supabase plus the selected D1 Worker and
# run-artifact-R2 profile. Artwork R2 is optional, but configure it as a
# complete target-specific set if enabled. Do not mix profiles.

# Development Supabase: Kartiseret - dev (jbydpmjjptwevyijarzl)
DEV_SUPABASE_URL=https://jbydpmjjptwevyijarzl.supabase.co
DEV_SUPABASE_PUBLISHABLE_KEY=replace-with-dev-publishable-key
DEV_SUPABASE_SERVICE_ROLE_KEY=replace-with-dev-service-role-key

# Optional for local Node server / direct category publication. Use the runtime
# login, not postgres/admin. Connection username must include the project ref.
DEV_DATABASE_URL=postgresql://kartiseret_api.jbydpmjjptwevyijarzl:replace-me@transaction-pooler-host:6543/postgres
DEV_DATABASE_SSL_CA_CERT=replace-with-full-dev-Supabase-CA-certificate-PEM
DEV_DATABASE_POOL_MAX=1
DEV_PUBLICATION_DATABASE_URL=
DEV_PUBLICATION_DATABASE_SSL_CA_CERT=

# Development artwork R2. Leave the bucket/origin/writer values empty to disable mirroring.
# Before enabling writes, use a stable development app origin that can serve
# /api/images; localhost works only for a local browser and must not be stored
# in shared catalog records. The app credentials are read-only.
DEV_R2_BUCKET=
DEV_R2_IMAGE_ORIGIN=
DEV_R2_ACCESS_KEY_ID=
DEV_R2_SECRET_ACCESS_KEY=
DEV_R2_READ_ACCESS_KEY_ID=
DEV_R2_READ_SECRET_ACCESS_KEY=

# Dedicated private diagnostic-artifact bucket and D1 database.
DEV_D1_DATABASE_ID=dbace3cc-386d-42f4-8ab9-0863f17adcfc
DEV_RUN_LOGS_API_URL=https://kartiseret-run-artifact-retention-dev.jeremyjacob101.workers.dev
DEV_RUN_LOGS_API_SECRET=
DEV_RUN_ARTIFACTS_R2_BUCKET=kartiseret-run-artifacts-dev
DEV_RUN_ARTIFACTS_R2_ACCESS_KEY_ID=
DEV_RUN_ARTIFACTS_R2_SECRET_ACCESS_KEY=

# Production Supabase: KartiseretNew (gsdrcyrduxbrxgsvhxvr)
PROD_SUPABASE_URL=https://gsdrcyrduxbrxgsvhxvr.supabase.co
PROD_SUPABASE_PUBLISHABLE_KEY=replace-with-production-publishable-key
PROD_SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key

# Optional for a local Node server / direct category publication. Use the
# production runtime login and its certificate, not an elevated migration URL.
PROD_DATABASE_URL=postgresql://kartiseret_api.gsdrcyrduxbrxgsvhxvr:replace-me@transaction-pooler-host:6543/postgres
PROD_DATABASE_SSL_CA_CERT=replace-with-full-production-Supabase-CA-certificate-PEM
PROD_DATABASE_POOL_MAX=1
PROD_PUBLICATION_DATABASE_URL=
PROD_PUBLICATION_DATABASE_SSL_CA_CERT=

# Production R2. The image endpoint reads through the app's read-only key.
PROD_R2_BUCKET=
PROD_R2_IMAGE_ORIGIN=
PROD_R2_ACCESS_KEY_ID=
PROD_R2_SECRET_ACCESS_KEY=
PROD_R2_READ_ACCESS_KEY_ID=
PROD_R2_READ_SECRET_ACCESS_KEY=

# Dedicated private diagnostic-artifact bucket and D1 database.
# Create these production resources only after production provisioning is approved.
PROD_D1_DATABASE_ID=replace-with-production-d1-database-uuid
PROD_RUN_LOGS_API_URL=https://kartiseret-run-artifact-retention-prod.jeremyjacob101.workers.dev
PROD_RUN_LOGS_API_SECRET=
PROD_RUN_ARTIFACTS_R2_BUCKET=kartiseret-run-artifacts-prod
PROD_RUN_ARTIFACTS_R2_ACCESS_KEY_ID=
PROD_RUN_ARTIFACTS_R2_SECRET_ACCESS_KEY=

# Shared non-environment-specific settings
# Both environments use this Cloudflare account. D1 requests go through a
# separately deployed Worker bound to the selected environment's database;
# each R2 key is scoped to one private artifact bucket.
R2_ACCOUNT_ID=
NODE_ENV=development
PORT=3000
SITE_ORIGIN=http://localhost:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
TMDB_API_KEY=replace-me

# Development alert credentials are always disabled by the target resolver.
# These production-only credentials are opt-in for local production runs.
PROD_RESEND_API_KEY=
PROD_TICKET_ALERT_RECIPIENT_API_URL=
PROD_TICKET_ALERT_INTERNAL_API_SECRET=

# Local disposable integration-test DB. Never point this at Supabase.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kartiseret_test

# Local application auth. These are not Supabase or R2 credentials.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_SECRET=replace-with-a-different-random-secret

# Manual database migrations use a separately selected operator/admin URL.
# This variable is deliberately not switched by the scraper target selector.
MIGRATION_DATABASE_URL=
