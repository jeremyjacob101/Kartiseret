{
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/user",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/reset-password",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/attribution",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*-[A-Za-z0-9_-]{8}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "Codebase - Kartiseret Web/dist",
  "functions": {
    "api/dispatch.ts": {
      "includeFiles": "{Codebase - Kartiseret Web/dist/**,Codebase - Kartiseret Web/dist-ssr/**,Codebase - Kartiseret Web/server/og/assets/**,packages/**/dist/**}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/dispatch?__vercel_route=page&path=/"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/dispatch?__vercel_route=page&path=/"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/dispatch?__vercel_route=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/dispatch?__vercel_route=sitemap"
    },
    {
      "source": "/c/:cinemaId",
      "destination": "/api/dispatch?__vercel_route=cinema&cinemaId=:cinemaId"
    },
    {
      "source": "/movies",
      "destination": "/api/dispatch?__vercel_route=page&path=/movies"
    },
    {
      "source": "/showtimes",
      "destination": "/api/dispatch?__vercel_route=page&path=/showtimes"
    },
    {
      "source": "/soons",
      "destination": "/api/dispatch?__vercel_route=page&path=/soons"
    },
    {
      "source": "/cinematheques",
      "destination": "/api/dispatch?__vercel_route=page&path=/cinematheques"
    },
    {
      "source": "/user",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/attribution",
      "destination": "/index.html"
    },
    {
      "source": "/:routeCode([0-9A-Za-z]{3,10})",
      "destination": "/api/dispatch?__vercel_route=movie&routeCode=:routeCode"
    },
    {
      "source": "/api",
      "destination": "/api/dispatch"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/dispatch?__vercel_route=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/dispatch?__vercel_route=not-found&path=/$1"
    }
  ]
}
