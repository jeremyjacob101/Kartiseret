{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "Codebase - Kartiseret Web/dist",
  "functions": {
    "api/dispatch.ts": {
      "includeFiles": "{Codebase - Kartiseret Web/dist/**,Codebase - Kartiseret Web/server/og/assets/**,packages/**/dist/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/movies",
      "destination": "/index.html"
    },
    {
      "source": "/showtimes",
      "destination": "/index.html"
    },
    {
      "source": "/soons",
      "destination": "/index.html"
    },
    {
      "source": "/user",
      "destination": "/index.html"
    },
    {
      "source": "/attribution",
      "destination": "/index.html"
    },
    {
      "source": "/:routeCode([0-9A-Za-z]{3,10})",
      "destination": "/api/dispatch?__vercel_route=og&routeCode=:routeCode"
    },
    {
      "source": "/api",
      "destination": "/api/dispatch?__vercel_route=not-found"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/dispatch?__vercel_route=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
