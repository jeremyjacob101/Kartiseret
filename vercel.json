{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "Codebase - Kartiseret Web/dist",
  "functions": {
    "api/og.ts": {
      "includeFiles": [
        "Codebase - Kartiseret Web/dist/**",
        "packages/server/dist/**",
        "packages/contracts/dist/**"
      ]
    },
    "api/og-image.ts": {
      "maxDuration": 30,
      "includeFiles": [
        "Codebase - Kartiseret Web/server/og/assets/**",
        "packages/server/dist/**",
        "packages/contracts/dist/**"
      ]
    },
    "api/[...path].ts": {
      "includeFiles": "packages/**/dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/movies",
      "destination": "/index.html"
    },
    {
      "source": "/showtimes",
      "destination": "/index.html"
    },
    {
      "source": "/soons",
      "destination": "/index.html"
    },
    {
      "source": "/user",
      "destination": "/index.html"
    },
    {
      "source": "/attribution",
      "destination": "/index.html"
    },
    {
      "source": "/:routeCode([0-9A-Za-z]{3,10})",
      "destination": "/api/og?routeCode=:routeCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
