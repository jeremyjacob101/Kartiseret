{
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/user",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/reset-password",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/confirm-account-deletion",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/attribution",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/support",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/accessibility",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/privacy",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/terms",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/unsubscribe/letterboxd",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*-[A-Za-z0-9_-]{8}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "Codebase - Kartiseret Web/dist",
  "functions": {
    "api/dispatch.ts": {
      "includeFiles": "{Codebase - Kartiseret Web/dist/**,Codebase - Kartiseret Web/dist-ssr/**,Codebase - Kartiseret Web/server/og/assets/**,packages/**/dist/**}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/index\\.html$",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "dest": "/api/dispatch?__vercel_route=private-page&path=/"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/dispatch?__vercel_route=page&path=/"
    },
    {
      "src": "^/third-party-licenses\\.txt$",
      "dest": "/api/dispatch?__vercel_route=page&path=/third-party-licenses.txt"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "dest": "/api/dispatch?__vercel_route=private-page&path=/"
    },
    {
      "src": "^/$",
      "dest": "/api/dispatch?__vercel_route=page&path=/"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/apple-app-site-association"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-page&path=/"
    },
    {
      "source": "/",
      "destination": "/api/dispatch?__vercel_route=page&path=/"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-page&path=/"
    },
    {
      "source": "/index.html",
      "destination": "/api/dispatch?__vercel_route=page&path=/"
    },
    {
      "source": "/third-party-licenses.txt",
      "destination": "/api/dispatch?__vercel_route=page&path=/third-party-licenses.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/dispatch?__vercel_route=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/dispatch?__vercel_route=sitemap"
    },
    {
      "source": "/movies",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-page&path=/movies"
    },
    {
      "source": "/movies",
      "destination": "/api/dispatch?__vercel_route=page&path=/movies"
    },
    {
      "source": "/showtimes",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-page&path=/showtimes"
    },
    {
      "source": "/showtimes",
      "destination": "/api/dispatch?__vercel_route=page&path=/showtimes"
    },
    {
      "source": "/showtimes/:citySlug",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-page&path=/showtimes/:citySlug"
    },
    {
      "source": "/showtimes/:citySlug",
      "destination": "/api/dispatch?__vercel_route=page&path=/showtimes/:citySlug"
    },
    {
      "source": "/soons",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-page&path=/soons"
    },
    {
      "source": "/soons",
      "destination": "/api/dispatch?__vercel_route=page&path=/soons"
    },
    {
      "source": "/cinematheques",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-page&path=/cinematheques"
    },
    {
      "source": "/cinematheques",
      "destination": "/api/dispatch?__vercel_route=page&path=/cinematheques"
    },
    {
      "source": "/user",
      "destination": "/api/dispatch?__vercel_route=page&path=/user"
    },
    {
      "source": "/confirm-account-deletion",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/api/dispatch?__vercel_route=page&path=/reset-password"
    },
    {
      "source": "/attribution",
      "destination": "/api/dispatch?__vercel_route=page&path=/attribution"
    },
    {
      "source": "/support",
      "destination": "/api/dispatch?__vercel_route=page&path=/support"
    },
    {
      "source": "/accessibility",
      "destination": "/api/dispatch?__vercel_route=page&path=/accessibility"
    },
    {
      "source": "/privacy",
      "destination": "/api/dispatch?__vercel_route=page&path=/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/dispatch?__vercel_route=page&path=/terms"
    },
    {
      "source": "/unsubscribe/letterboxd",
      "destination": "/index.html"
    },
    {
      "source": "/:routeCode([a-z0-9]{8})",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-route-code&code=:routeCode"
    },
    {
      "source": "/:routeCode([a-z0-9]{8})",
      "destination": "/api/dispatch?__vercel_route=route-code&code=:routeCode"
    },
    {
      "source": "/:emailAction([A-Za-z0-9._-]{17,4096})",
      "destination": "/api/dispatch?__vercel_route=email-action&code=:emailAction"
    },
    {
      "source": "/:routeCode([0-9A-Za-z]{3,10})",
      "has": [
        {
          "type": "header",
          "key": "cookie",
          "value": "(?:.*;\\s*)?(?:__Secure-)?kartiseret-(?:production|preview|development)\\.session_token=[^;]+(?:;.*)?"
        }
      ],
      "destination": "/api/dispatch?__vercel_route=private-legacy-movie&routeCode=:routeCode"
    },
    {
      "source": "/:routeCode([0-9A-Za-z]{3,10})",
      "destination": "/api/dispatch?__vercel_route=legacy-movie&routeCode=:routeCode"
    },
    {
      "source": "/api",
      "destination": "/api/dispatch"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/dispatch?__vercel_route=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/dispatch?__vercel_route=not-found&path=/$1"
    }
  ]
}
